<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="TRANG CHỦ (HOME)"
        android:textColor="#34B469"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:text="Chào mừng người dùng mới!"
        android:textColor="#1B2631"
        android:textSize="16sp"
        android:textStyle="italic" />

    <TextView
        android:id="@+id/tvUserInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F5F7FA"
        android:lineSpacingExtra="8dp"
        android:padding="20dp"
        android:textColor="#1B2631"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="#1B2631"
        android:text="ĐĂNG XUẤT / QUAY LẠI" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="#EFEFEF"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:padding="12dp"
        android:text="Họ và tên: Ngô Võ Quý\nMSSV: 2415053122236\nLHP: 126TLTTD01"
        android:textColor="#1B2631"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>